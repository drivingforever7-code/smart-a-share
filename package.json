{
  "name": "smart-a-share",
  "version": "0.1.0",
  "private": true,
  "description": "面向短线与波段的本地 A 股量化选股网站",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "backend:dev": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8710 --reload",
    "backend:test": "python -m pytest backend/tests"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "dayjs": "^1.11.21",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
